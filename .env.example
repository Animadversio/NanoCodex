DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=

# Optional: read Discord credentials from another env file instead. This may
# be set in the host environment or here as an absolute path; the agent runner
# never receives the token.
# NANOCLAW_DISCORD_ENV_FILE=/absolute/path/to/discord.env

# NanoCodex defaults; keep these explicit while the fork is experimental.
DEFAULT_AGENT_PROVIDER=codex
NANOCLAW_RUNTIME_DRIVER=native
NANOCLAW_GATEWAY_PROVIDER=direct

# Development checkouts warn on an upgrade-state mismatch but keep starting,
# which permits normal Git commits and rollbacks. Opt into a hard startup stop
# only for production-like deployments.
# NANOCODEX_STRICT_UPGRADE_STATE=true

# Optional display and scheduling settings.
ASSISTANT_NAME=Andy
TZ=America/New_York
